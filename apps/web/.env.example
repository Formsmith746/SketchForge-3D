# Public static-build settings (placeholders only).
NEXT_PUBLIC_SKETCHFORGE_DEMO_HOST=localhost
SKETCHFORGE_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Worker secrets belong in .dev.vars locally or Cloudflare secrets in staging.
# Never prefix secrets with NEXT_PUBLIC_ and never commit real values.
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Non-secret Worker variables are configured in wrangler.staging.jsonc.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
STRIPE_PRICE_ID=price_replace_with_test_price
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_with_test_configuration
APP_BASE_URL=http://127.0.0.1:8787
CURRENT_TERMS_VERSION=2026-07-14
CURRENT_PRIVACY_VERSION=2026-07-14
