{
  "name": "sketchforge3d",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "copy:occt": "node scripts/copy-occt-wasm.mjs",
    "predev": "npm run copy:occt",
    "dev": "next dev apps/web",
    "prebuild": "npm run copy:occt",
    "build": "next build apps/web",
    "export": "cross-env STATIC_EXPORT=true next build apps/web && node scripts/verify-static-worker-assets.mjs",
    "verify:static-worker-assets": "node scripts/verify-static-worker-assets.mjs",
    "cloudflare:check": "npm run production:check",
    "cloudflare:dev": "npm run export && wrangler dev -c wrangler.jsonc",
    "cloudflare:deploy": "npm run production:deploy",
    "staging:build": "npm run export",
    "staging:check": "npm run staging:build && wrangler deploy --dry-run -c wrangler.staging.jsonc",
    "staging:dev": "npm run staging:build && wrangler dev -c wrangler.staging.jsonc",
    "staging:deploy": "npm run staging:build && wrangler deploy -c wrangler.staging.jsonc",
    "production:check": "npm run export && wrangler deploy --dry-run -c wrangler.jsonc",
    "production:deploy": "node scripts/production-deploy.mjs",
    "start": "next start apps/web",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build",
    "sanity:deploy": "sanity deploy",
    "sanity:schema:validate": "sanity schema validate",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "vitest run --config tests/vitest.e2e.config.ts",
    "perf": "vitest run --config tests/vitest.perf.config.ts --reporter verbose",
    "ci": "npm run typecheck && npm run test",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t sketchforge:local .",
    "docker:run": "docker run --rm -p 3000:80 sketchforge:local",
    "docker:up": "docker compose -f deploy/docker/compose.yaml up --build -d",
    "docker:down": "docker compose -f deploy/docker/compose.yaml down",
    "mcp:sketchforge": "node scripts/sketchforge-mcp-server.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^7.0.1",
    "@sanity/image-url": "2.1.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/three": "^0.184.1",
    "brepjs": "^18.118.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.511.0",
    "manifold-3d": "^3.5.0",
    "next": "^15.3.2",
    "next-sanity": "11.6.13",
    "occt-wasm": "^3.6.1",
    "react": "^19.1.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.13"
  },
  "devDependencies": {
    "@sanity/cli": "4.22.0",
    "@sanity/vision": "4.22.0",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "cross-env": "^10.1.0",
    "sanity": "4.22.0",
    "styled-components": "^6.1.19",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.111.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
