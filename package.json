{
  "name": "sketchforge",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "export": "set STATIC_EXPORT=true&& next build apps/web",
    "start": "next start apps/web",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "perf": "vitest run --config tests/vitest.perf.config.ts --reporter verbose",
    "ci": "npm run typecheck && npm run test",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t sketchforge:local .",
    "docker:run": "docker run --rm -p 3000:80 sketchforge:local",
    "docker:up": "docker compose -f deploy/docker/compose.yaml up --build -d",
    "docker:down": "docker compose -f deploy/docker/compose.yaml down",
    "desktop:export": "STATIC_EXPORT=true next build apps/web",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run desktop:export && tauri build",
    "desktop:flatpak": "flatpak-builder --user --install --force-clean .flatpak-builddir flatpak/info.friedjof.SketchForge3D.yaml",
    "desktop:flatpak:bundle": "test -f apps/web/out/index.html || npm run desktop:export && tar -czf flatpak/web-out.tar.gz -C apps/web out && flatpak-builder --repo=.flatpak-repo --force-clean .flatpak-builddir flatpak/info.friedjof.SketchForge3D.yaml && flatpak build-bundle .flatpak-repo dist/SketchForge3D.flatpak info.friedjof.SketchForge3D && echo 'Install: flatpak install --user dist/SketchForge3D.flatpak'"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/three": "^0.184.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "manifold-3d": "^3.5.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
