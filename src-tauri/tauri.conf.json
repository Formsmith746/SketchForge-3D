{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SketchForge 3D",
  "version": "0.3.5",
  "identifier": "info.friedjof.sketchforge3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../apps/web/out"
  },
  "app": {
    "windows": [
      {
        "title": "SketchForge 3D",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
